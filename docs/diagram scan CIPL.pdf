4261 0 obj
  << /ActualText (Tidak bisa disimulasikan\056 terlalu banyak variable\056 simulasi paling mendekati\072\nSimulasi Implementasi\nAsumsi Dasar\072\nPanjang total kandang\072 20 meter\nJumlah jalur telur \050setiap 3 ayam 1 jalur\051\072 167 jalur\nSensor berjalan sepanjang 20 meter untuk mendeteksi telur\056\nMenggunakan sensor TOF400C\055VL53L1X dengan I2C\056\nMenggunakan motor stepper \053 rail sebagai mekanisme gondola\056\nGondola dapat bergerak dengan kecepatan 1 meter\057detik \222 scanning selesai dalam 20 detik\056\nSetiap pemindaian dapat dilakukan dalam interval tertentu\054 misalnya setiap 2\0555 menit\056\n)
     /K [ 1910 ]
     /P 4262 0 R
     /Pg 460 0 R
     /S /Span
     /Type /StructElem
  >>
endobj

4262 0 obj
  << /K [ 4261 0 R ]
     /P 6102 0 R
     /S /P
     /Pg 460 0 R
     /Type /StructElem
  >>
endobj

4263 0 obj
  << /ActualText (Keunggulan Metode Ini\072\050\005 Jumlah sensor lebih sedikit \050cukup 1 atau 2 sensor per jalur\051\056\050\005 Lebih hemat biaya dibandingkan memasang sensor di setiap jalur\056\050\005 Bisa mencatat posisi dan jumlah telur secara akurat\056\050\005 Tidak perlu wiring banyak ke setiap jalur telur\054 cukup ke sistem gondola\056\nTantangan\072\050\240\017 Mekanisme gerak harus stabil dan presisi\056\050\240\017 Kecepatan deteksi tergantung kecepatan gondola\056\050\240\017 Perlu sistem kontrol untuk gerak gondola\056)
     /K [ 1911 ]
     /P 4264 0 R
     /Pg 460 0 R
     /S /Span
     /Type /StructElem
  >>
endobj

4264 0 obj
  << /K [ 4263 0 R ]
     /P 6102 0 R
     /S /P
     /Pg 460 0 R
     /Type /StructElem
  >>
