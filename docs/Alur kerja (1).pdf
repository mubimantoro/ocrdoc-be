3843 0 obj
  << /ActualText (Saran Alternatif\nSelain metode sensor berjalan \050gondola TOF\051 dan sensor tetap di jalur\054 berikut beberapa pendekatan lain yang bisa dipertimbangkan\072\nKamera bergerak\053 AI Image Processing \nMenggunakan kamera di atas jalur telur yang mengambil gambar secara berkala\056\nAI\057ML mendeteksi jumlah telur dalam gambar tanpa perlu banyak sensor\056\nKeunggulan\072\050\005 Dapat menghitung jumlah telur dengan akurat\056\050\005 Tidak perlu banyak wiring\056\nKekurangan\072\050\240\017 Butuh pemrosesan tambahan \050Raspberry Pi atau PC\051\056\050\240\017 Pencahayaan harus stabil untuk akurasi tinggi\056\050\240\017 Sistem wiring bakal kompleks\056\050\240\017 sisten bergerak\nSensor Berat \050Load Cell\051 di Ujung Jalur\nMenempatkan load cell di ujung jalur untuk mendeteksi berat total telur yang terkumpul\056\nTidak perlu mendeteksi satu per satu\054 cukup melihat perubahan berat sebagai indikator\056\nKeunggulan\072\050\005 Tidak perlu mekanisme gerak\056\050\005 Dapat mengukur produksi telur secara total\056\nKekurangan\072\050\240\017 Tidak bisa mendeteksi setiap telur individu secara langsung\056)
     /K [ 1739 ]
     /P 3844 0 R
     /Pg 384 0 R
     /S /Span
     /Type /StructElem
  >>
endobj

3844 0 obj
  << /K [ 3843 0 R ]
     /P 6030 0 R
     /S /P
     /Pg 384 0 R
     /Type /StructElem
  >>
endobj

3845 0 obj
  << /ActualText (Kesimpulan\nJika ingin solusi hemat dan sederhana\054 limit switch di jalur telur dengan multiplexer adalah opsi terbaik\056\nJika ingin solusi yang lebih fleksibel dan akurat\054 sensor TOF bergerak \050gondola\051 adalah pilihan menengah yang cukup baik\056\nJika ingin analisis lebih canggih\054 kamera dengan AI dapat menjadi solusi\054 meskipun lebih mahal dan kompleks\056\nJika hanya ingin estimasi produksi telur secara keseluruhan\054 load cell di ujung jalur bisa jadi alternatif tanpa perlu mendeteksi satu per satu\056)
     /K [ 1740 ]
     /P 3846 0 R
     /Pg 384 0 R
     /S /Span
     /Type /StructElem
  >>
