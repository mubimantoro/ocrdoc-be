4235 0 obj
  << /ActualText (Simulasi Sistem Hybrid Perhitungan Produksi Telur\nAsumsi Dasar\072\nSetiap ayam membutuhkan 40 cm kandang\nTotal panjang kandang per baris\072 20 meter \222 500 ayam per baris\nDua sistem sensor digunakan\072\nLoad Cell \053 MCU untuk mendeteksi berat total telur ayam\nSensor TOF dengan Gondola untuk menghitung telur di jalur\n1 ayam bertelur 1 butir per hari\nSegmentasi Pengukuran\072\nPengukuran dilakukan setiap 4\057meter\054 sehingga 1 baris 20\057m terbagi atas 5 segmen\056\n\nSimulasi Sistem Load Cell \053 MCU\nSpesifikasi \046 Kapasitas\nCakupan per sistem\072 4\057m \050segmen kandang\051\056\nJumlah ayam per segmen\072 \050500 ayam \057 20 m\051 x 4 m \075 100 ayam\nProduksi telur per segmen\072 100 butir\057hari\056\nAsumsi pengukuran\072\n1 telur H 70\057gram\056\nPilihan Load Cell\072\nLoad cell 5\057kg\072\050 Kapasitas maksimal berat \075 5\056000\057gram \222\050 Jumlah telur maksimal \075 5\056000 \057 70 H 71 butir\056\050Catatan\072 Kapasitas ini kurang untuk segmen yang menghasilkan 100 telur kecuali sebelum mencapai 71 butir dilakukan panen\056\nLoad cell 10\057kg\072\050 Kapasitas maksimal berat \075 10\056000\057gram \222\050 Jumlah telur maksimal \075 10\056000 \057 70 H 142 butir\056\050 Kapasitas ini cukup untuk mengcover segmen 100 telur\056\nPerhitungan Kebutuhan Hardware \050per segmen 4\057m\051\nMCU \050ESP32\051\072 Rp75\056000\nLoad Cell \0505\057kg atau 10\057kg\051\072 Rp20\056000\nTotal biaya per segmen\072 Rp75\056000 \053 Rp20\056000 \075 Rp95\056000\nTotal untuk 1 Baris Kandang \05020\057m\051\nJumlah segmen\072 20 m \057 4 m \075 5\nTotal biaya Load Cell \053 MCU\072\050 5 \327 Rp95\056000 \075 Rp475\056000\nTotal diluar kebutuhan lainnya\n)
     /K [ 1942 ]
     /P 4236 0 R
     /Pg 370 0 R
     /S /Span
     /Type /StructElem
  >>
endobj

4236 0 obj
  << /K [ 4235 0 R ]
     /P 6026 0 R
     /S /P
     /Pg 370 0 R
     /Type /StructElem
  >>
endobj

4237 0 obj
  << /ActualText (Simulasi Sistem Sensor TOF \053 Gondola\nSistem TOF dengan gondola bergerak di atas jalur telur dapat diimplementasikan dengan dua pendekatan\072\nPendekatan A\072 1 Sistem yang Mencakup Seluruh 20\057m\nSpesifikasi Sistem\072\nMencakup seluruh baris kandang \050500 ayam\051 dengan gondola yang melintasi 20\057m\056\nKebutuhan Hardware\072\nMCU \050ESP32\051\072 Rp75\056000\nSensor TOF\072 Rp45\056000\nTiming Belt\072\nGondola bergerak sepanjang 20\057m \050bolak\055balik \222 40\057m total\051\nBiaya\072 40 m \327 Rp15\056000 \075 Rp600\056000\nGT2 W10 D18 B5 20T Pulley Idler\072 4 pcs \327 Rp15\056000 \075 Rp60\056000\nGT2 Timing Pulley 20 Teeth Gear\072 1 pcs \327 Rp7\056500 \075 Rp7\056500\nPegas\072 2 pcs \327 Rp7\056500 \075 Rp15\056000\nBase Gondola \050akrilik\0573D print\051\072 Rp350\056000\nStepper Motor \053 Driver\072 Rp20\056000\nKabel Komunikasi\072 \050misalnya 20 m\051 20 m \327 Rp2\056500 \075 Rp50\056000\nLimit Switch\072 2 pcs \327 Rp3\0565\056000 \075 Rp7\056000\nEstimasi Total Biaya Pendekatan A\072\n)
     /K [ 1943 ]
     /P 4238 0 R
     /Pg 370 0 R
     /S /Span
     /Type /StructElem
  >>
endobj

