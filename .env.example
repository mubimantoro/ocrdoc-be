# Server Configuration
HOST=localhost
PORT=5000
CORS_ORIGIN=*

# Database Configuration (PostgreSQL)
# Format: postgres://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgres://postgres:password@localhost:5432/ocrdoc

# Redis Configuration (For BullMQ & Socket.io)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Security / JWT Keys
# Ganti dengan string acak (misal bisa di-generate pakai node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
ACCESS_TOKEN_KEY=your_super_secret_access_key
REFRESH_TOKEN_KEY=your_super_secret_refresh_key
JWT_SECRET=your_super_secret_jwt_key
ACCESS_TOKEN_AGE=15m
REFRESH_TOKEN_AGE=7d

# Google Gemini AI Configuration
GEMINI_API_KEY=your_gemini_api_key_here
AI_PROVIDER=gemini
GEMINI_CHEAP_MODEL=gemini-3.1-flash-lite-preview
GEMINI_SMART_MODEL=gemini-3-flash-preview

# AI Billing Rates (Untuk kalkulasi biaya OCR)
GEMINI_CHEAP_INPUT_RATE=0.075
GEMINI_CHEAP_OUTPUT_RATE=0.30
GEMINI_FLAGSHIP_INPUT_RATE=0.35
GEMINI_FLAGSHIP_OUTPUT_RATE=1.05

# Webhook Configuration (Opsional)
CLIENT_WEBHOOK_URL=http://localhost:3000/api/webhook
WEBHOOK_SECRET=your_webhook_secret
